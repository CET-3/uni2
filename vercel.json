{
  "version": 2,
  "builds": [
    {
      "src": "wsgi_app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "includeFiles": ["templates/**", "static/**", "*/migrations/**", "config/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "wsgi_app.py"
    }
  ]
}
