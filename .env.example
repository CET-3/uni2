# Plantilla para desarrollo local con SQLite.
# Este archivo no contiene secretos: se puede copiar como .env.
DJANGO_SETTINGS_MODULE=config.settings.local

# Perfil local recomendado para alumnos.
# SQLite viene incluido con Python y guarda los datos en db.sqlite3.
DB_ENGINE=sqlite

# En desarrollo los correos transaccionales se imprimen en la consola del
# servidor: no se conectan al SMTP ni llegan a direcciones reales.
UNI2_SITE_URL=http://localhost:8000
UNI2_TRANSACTIONAL_EMAIL_MODE=enabled
DEFAULT_FROM_EMAIL=UNI2 <no-responder@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=reemplazar
EMAIL_HOST_PASSWORD=reemplazar
EMAIL_USE_TLS=true
