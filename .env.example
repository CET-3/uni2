DJANGO_SETTINGS_MODULE=config.settings.local

# Opciones:
# - sqlite  -> usa db.sqlite3 local
# - postgres -> usa PostgreSQL con las variables de abajo
DB_ENGINE=postgres
DB_NAME=uni2
DB_USER=root
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# --- Storage externo (S3 / R2) ------------------------------------------------
# Opcional. Si no se setean, las fotos se guardan en el filesystem local.
# AWS_STORAGE_BUCKET_NAME=uni2-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto

# Nota:
# Con DB_HOST vacio Django usa el socket local de PostgreSQL,
# igual que cuando ejecutas `psql kier`.
