# Plantilla de nombres para una operación de staging.
# Copiar como .env.staging y completar fuera del repositorio.
# No usar estos valores como credenciales ni versionar una copia completada.
# Las contraseñas, URLs con usuario/clave y claves AWS son secretos.
# Las huellas no son contraseñas: identifican el recurso esperado.
DJANGO_SETTINGS_MODULE=config.settings.staging
UNI2_ENVIRONMENT=staging
# Secreto Django exclusivo de staging; no reutilizar el de Production.
SECRET_KEY=reemplazar
# Sólo durante un refresco manual. Es una URL secreta con acceso de lectura.
# Usar Session pooler y quitarla al terminar.
UNI2_PRODUCTION_COPY_DATABASE_URL=postgresql://usuario:clave@produccion.example/uni2
# URL secreta de la base staging.
# Para preparar la copia usar Session pooler. En Vercel usar Transaction pooler.
DATABASE_URL=postgresql://usuario:clave@staging.example/uni2_staging
# Valores de configuración, no contraseñas.
ALLOWED_HOSTS=uni2-staging.example
CSRF_TRUSTED_ORIGINS=https://uni2-staging.example

# Credenciales de la segunda barrera HTTP de staging.
UNI2_STAGING_ACCESS_USERNAME=reemplazar
UNI2_STAGING_ACCESS_PASSWORD=reemplazar
# El label y las huellas verifican que la conexión apunta al destino correcto.
UNI2_STAGING_DATABASE_LABEL=uni2-staging
UNI2_STAGING_DATABASE_FINGERPRINT=reemplazar
UNI2_PRODUCTION_DATABASE_FINGERPRINT=reemplazar
UNI2_STAGING_DATABASE_ROLE_FINGERPRINT=reemplazar
UNI2_PRODUCTION_DATABASE_ROLE_FINGERPRINT=reemplazar
UNI2_PRIVATE_DATA_EPOCH=AAAA-MM-DD-NN

# Opcional. Sin estas variables, staging no muestra los archivos media.
# El bucket debe ser privado, exclusivo y diferente del productivo.
# UNI2_STAGING_AWS_STORAGE_BUCKET_NAME=reemplazar
# UNI2_STAGING_AWS_ACCESS_KEY_ID=reemplazar
# UNI2_STAGING_AWS_SECRET_ACCESS_KEY=reemplazar
# UNI2_STAGING_AWS_S3_ENDPOINT_URL=https://storage.example
# UNI2_STAGING_AWS_S3_REGION_NAME=auto
# UNI2_STAGING_STORAGE_FINGERPRINT=reemplazar
# UNI2_PRODUCTION_STORAGE_FINGERPRINT=reemplazar

# Variables temporales para preparar_copia_staging. Son secretos cuando son
# contraseñas y deben quitarse al terminar el endurecimiento.
# Los nombres de usuario QA no son secretos, pero se mantienen aquí sólo como
# valores de ejemplo.
UNI2_STAGING_QA_ADMIN_USERNAME=qa-admin
UNI2_STAGING_QA_ADMIN_PASSWORD=reemplazar
UNI2_STAGING_QA_ASOCIADO_A_USERNAME=qa-asociado-a
UNI2_STAGING_QA_ASOCIADO_A_PASSWORD=reemplazar
UNI2_STAGING_QA_ASOCIADO_B_USERNAME=qa-asociado-b
UNI2_STAGING_QA_ASOCIADO_B_PASSWORD=reemplazar
UNI2_STAGING_QA_COMERCIO_USERNAME=qa-comercio
UNI2_STAGING_QA_COMERCIO_PASSWORD=reemplazar
