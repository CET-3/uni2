DJANGO_SETTINGS_MODULE=config.settings.local

# Perfil local para trabajar con PostgreSQL.
DB_ENGINE=postgres
DB_NAME=uni2
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Storage externo (S3 / R2) ------------------------------------------------
# Opcional. Si no se setean, las fotos se guardan en el filesystem local.
# AWS_STORAGE_BUCKET_NAME=uni2-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto

# Nota:
# Si la instalación local usa un socket de PostgreSQL, se puede dejar
# DB_HOST vacío.
